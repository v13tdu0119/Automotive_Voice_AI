<?xml version="1.0" encoding="utf-8"?>
<!-- OEM allowlist for the privileged car permissions used by the real flavor.
     Push to /system/etc/permissions/ (or /vendor/etc/permissions/) alongside a
     privileged install of the APK; see README "Running the real flavor". -->
<permissions>
    <privapp-permissions package="com.sopa.viva_automotive">
        <permission name="android.car.permission.CONTROL_CAR_CLIMATE" />
        <permission name="android.car.permission.CONTROL_CAR_DOORS" />
        <permission name="android.car.permission.CONTROL_CAR_INTERIOR_LIGHTS" />
        <permission name="android.car.permission.READ_CAR_INTERIOR_LIGHTS" />
    </privapp-permissions>
</permissions>
